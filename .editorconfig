# EditorConfig 配置文件
# 用于在不同编辑器和IDE之间保持一致的编码风格

root = true

# 所有文件的默认设置
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# JavaScript/TypeScript 文件
[*.{js,ts,jsx,tsx}]
indent_size = 2

# Python 文件
[*.py]
indent_size = 4

# Java 文件
[*.java]
indent_size = 4

# YAML 文件
[*.{yml,yaml}]
indent_size = 2

# JSON 文件
[*.json]
indent_size = 2

# XML 文件
[*.xml]
indent_size = 2

# CSS/SCSS 文件
[*.{css,scss,sass}]
indent_size = 2

# HTML 文件
[*.html]
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# Makefile
[Makefile]
indent_style = tab